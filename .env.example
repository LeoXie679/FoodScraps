# Copy this file to .env and fill in real values. NEVER commit .env.

# --- Bright Data (Person A) ---
# Dashboard → Settings / API → create or copy API token
BRIGHTDATA_API_TOKEN=

# Instagram posts discover dataset (usually leave as-is)
BRIGHTDATA_DATASET_ID=gd_lk5ns7kz21pck8jpis

# --- Postgres (Vultr Managed DB or Neon) ---
# Example: postgresql://user:pass@host:5432/defaultdb?sslmode=require
DATABASE_URL=

# --- Vultr Object Storage (S3-compatible) ---
S3_ENDPOINT=https://ewr1.vultrobjects.com
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=radar-raw
S3_REGION=us-east-1

# --- API ---
# Optional secret so only the demo laptop can hit scrape-now
ADMIN_TOKEN=changeme
# Person B's pipeline. Inside Docker Compose use the service hostname:
PIPELINE_URL=http://pipeline:8001/process
PIPELINE_TOKEN=change-me-shared-secret
# scrape-cron interval (seconds). Default 1800 = every 30 minutes.
SCRAPE_CRON_INTERVAL_SEC=1800
# Clubs per cron tick (rotates through the full list over time). Keep ≤12 so
# Bright Data finishes inside the API's 15-minute scrape timeout.
SCRAPE_CRON_LIMIT=12

# --- Leftovers ---
LEFTOVER_TTL_HOURS=2

# --- Person B vision (Vultr Serverless Inference) ---
VULTR_INFERENCE_API_KEY=
